node_modules/

# 构建期从上游抓取的引擎与词库，由 scripts/fetch-assets.mjs 生成
# （体积大且可复现；ASSETS.json 记录了来源与 sha256）
src/assets/*.gz
src/assets/*.txt
src/assets/.lock-applied

# 发版时由 scripts/release-meta.mjs 生成
npm/package.json
npm/manifest.json
npm/update.json
npm/LICENSE

# 完整词库构建（scripts/build-dict.mjs）的中间产物与打包结果
/.dict-build/
/dict/
